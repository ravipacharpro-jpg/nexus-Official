#!/usr/bin/env node
const { spawnSync } = require("child_process")
const path = require("path")

const root = path.join(__dirname, "..")
const entry = path.join(root, "src", "index.ts")
const bun = process.env.NEXUS_BUN || "bun"

const result = spawnSync(bun, ["run", "--cwd", root, "--conditions=browser", entry, ...process.argv.slice(2)], {
  stdio: "inherit",
  cwd: process.cwd(),
  env: process.env,
})

if (result.error) {
  console.error("NEXUS is a source build and requires the Bun runtime to launch.")
  console.error(`Could not run "${bun}": ${result.error.message}`)
  process.exit(1)
}

process.exit(typeof result.status === "number" ? result.status : 1)